# PostgreSQL connection string from Supabase Database settings.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase Project Settings > API.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[ANON_KEY]
SUPABASE_SERVICE_KEY=[SERVICE_ROLE_KEY]
SUPABASE_JWT_SECRET=[JWT_SECRET]

# Public frontend origin, without a trailing slash.
FRONTEND_URL=https://[YOUR_PROJECT].vercel.app

# Buckets must be created in Supabase Storage before deployment.
LABEL_BUCKET=label-images
REPORTS_BUCKET=compliance-reports

# Render's Python service needs the operating-system Tesseract binary.
TESSERACT_CMD=/usr/bin/tesseract
